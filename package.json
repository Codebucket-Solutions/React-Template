{
    "name": "react-template",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:worktree": "node scripts/run-vite-worktree.js dev",
        "build": "vite build",
        "start:stage": "env-cmd -f .buildParams.stage  npm run-script dev",
        "build:stage": "env-cmd -f .buildParams.stage npm run-script build",
        "start:master": "env-cmd -f .buildParams.master  npm run-script dev",
        "build:master": "env-cmd -f .buildParams.master npm run-script build",
        "lint": "eslint .",
        "preview": "vite preview",
        "preview:worktree": "node scripts/run-vite-worktree.js preview",
        "arch:check": "node scripts/check-architecture.js",
        "docs:generate": "node scripts/generate-route-map.js",
        "docs:validate": "node scripts/validate-docs.js",
        "quality:score": "node scripts/score-quality.js",
        "clean:artifacts": "node scripts/clean-artifacts.js",
        "plan:new": "node scripts/new-plan.js",
        "worktree:env": "node scripts/write-worktree-env.js",
        "worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
        "observability:up": "bash scripts/observability-up.sh",
        "observability:down": "bash scripts/observability-down.sh",
        "observability:status": "bash scripts/observability-status.sh",
        "observability:query": "bash scripts/observability-query.sh",
        "ui:smoke": "bash scripts/ui-smoke.sh",
        "verify": "npm run lint && npm run build && npm run docs:validate && npm run arch:check && npm run quality:score"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.7",
        "@mui/material": "^7.3.7",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/api-logs": "^0.213.0",
        "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
        "@opentelemetry/instrumentation": "^0.213.0",
        "@opentelemetry/instrumentation-document-load": "^0.58.0",
        "@opentelemetry/instrumentation-fetch": "^0.213.0",
        "@opentelemetry/instrumentation-user-interaction": "^0.57.0",
        "@opentelemetry/instrumentation-xml-http-request": "^0.213.0",
        "@opentelemetry/resources": "^2.6.0",
        "@opentelemetry/sdk-logs": "^0.213.0",
        "@opentelemetry/sdk-metrics": "^2.6.0",
        "@opentelemetry/sdk-trace-web": "^2.6.0",
        "@reduxjs/toolkit": "^2.11.2",
        "axios": "^1.13.1",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-hot-toast": "^2.6.0",
        "react-loading-overlay-ts": "^2.0.2",
        "react-picky": "^5.3.2",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.12.0",
        "react-select": "^5.10.2",
        "react-spinners": "^0.17.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@import-meta-env/unplugin": "^0.6.1",
        "@playwright/cli": "^0.1.1",
        "@types/react": "^19.1.16",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.0.4",
        "env-cmd": "^10.1.0",
        "eslint": "^9.36.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.22",
        "globals": "^16.4.0",
        "sass-embedded": "^1.93.2",
        "vite": "^7.1.7"
    }
}
